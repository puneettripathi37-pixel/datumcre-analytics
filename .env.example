# ---------------------------------------------------------------------------
# DatumCRE Analytics — environment variables
# Copy this file to `.env.local` and fill in the values you need.
# Never commit real credentials.
# ---------------------------------------------------------------------------

# Public site URL (used for canonical URLs, sitemap, Open Graph, JSON-LD).
# No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.datumcre.com

# ---------------------------------------------------------------------------
# Contact form email delivery (SMTP)
# Leave these blank in local development: the API route will validate the
# submission and log a redacted copy to the server console instead of sending.
# See README → "Contact form configuration".
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Address that receives new business inquiries.
CONTACT_TO_EMAIL=

# Optional "from" address. Defaults to SMTP_USER when omitted.
CONTACT_FROM_EMAIL=

# Optional reply-to override (defaults to the submitter's business email).
CONTACT_REPLY_TO_EMAIL=
