# ---------------------------------------------------------------------------
# DatumCRE Analytics — environment variables
# Copy this file to `.env.local` and fill in the values you need.
# Never commit real credentials.
# ---------------------------------------------------------------------------

# Public site URL (used for canonical URLs, sitemap, Open Graph, JSON-LD).
# Required in production. No trailing slash.
# When unset, the site falls back to VERCEL_PROJECT_PRODUCTION_URL if deployed
# on Vercel, then to http://localhost:3000 for local development.
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Public business details (rendered on the website)
# Leave blank until verified values are available. Empty values are hidden —
# a placeholder email is never displayed to visitors.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_BUSINESS_LOCATION=United States

# ---------------------------------------------------------------------------
# Contact form email delivery (SMTP)
# Leave these blank in local development: the API route validates the
# submission, logs a redacted copy to the server console, and returns an error
# because nothing was delivered. See README → "Contact form".
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Address that receives new business inquiries.
CONTACT_TO_EMAIL=

# Optional "from" address. Defaults to SMTP_USER when omitted.
CONTACT_FROM_EMAIL=

# Optional reply-to override (defaults to the submitter's business email).
CONTACT_REPLY_TO_EMAIL=
